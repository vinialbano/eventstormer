# Copy to .env and fill in. .env is gitignored and must never be committed.

# Anthropic API key for the facilitator. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Facilitator model. Ids take no date suffix.
# claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5-20251001
FACILITATOR_MODEL=claude-opus-5

PORT=5173
