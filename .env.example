# Copy to .env.local (preferred, for secrets) or .env and fill in. Both are
# gitignored; `pnpm dev` loads .env.local first, then .env. Only this example
# file is committed.

# Anthropic API key for the facilitator. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Primary facilitator model. Optional — defaults to claude-sonnet-5 (ADR-005).
# Supported: claude-sonnet-5 | claude-haiku-4-5. Ids take no date suffix.
# FACILITATOR_MODEL=claude-sonnet-5

# Run without an API key against a canned facilitator that replays a JSON script
# positionally (it ignores what you type). Copy e2e/fixtures/facilitator.json as
# a starting point; anything matching *.local.json is gitignored.
# FACILITATOR_MODE=scripted
# SCRIPTED_FACILITATOR_FILE=./facilitator.local.json

PORT=5173
