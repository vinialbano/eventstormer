{
  "name": "eventstormer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "db:reset": "node --eval \"for (const s of ['', '-wal', '-shm']) require('node:fs').rmSync('data/eventstormer.db' + s, { force: true })\"",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm depcruise && pnpm knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^10.0.1",
    "@hono/vite-dev-server": "0.26.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@vue/devtools-api": "8.2.1",
    "hono": "4.13.4",
    "nanoid": "6.0.1",
    "pinia": "4.0.3",
    "vue": "3.5.41"
  }
}
