{
  "name": "eventstormer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run --project domain --project app",
    "test:watch": "vitest --project domain --project app",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project domain --project app --coverage",
    "eval": "JITI_TSCONFIG_PATHS=1 jiti eval/run.ts",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "db:reset": "node --eval \"for (const s of ['', '-wal', '-shm']) require('node:fs').rmSync('data/eventstormer.db' + s, { force: true })\"",
    "changeset": "changeset",
    "spike:structured-output": "JITI_TSCONFIG_PATHS=1 jiti scripts/spike-structured-output.ts",
    "knip": "knip",
    "check:process-ids": "bash scripts/check-process-ids.sh",
    "check": "pnpm check:process-ids && pnpm typecheck && pnpm lint && pnpm test && pnpm depcruise && pnpm knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^10.0.1",
    "@hono/vite-dev-server": "0.26.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.4.6",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-vue": "10.10.0",
    "fast-check": "4.9.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.41",
    "@ai-sdk/otel": "1.0.77",
    "@vue/devtools-api": "8.2.1",
    "ai": "7.0.77",
    "hono": "4.13.4",
    "nanoid": "6.0.1",
    "pinia": "4.0.3",
    "reka-ui": "2.10.4",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  }
}
